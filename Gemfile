source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll', '~> 4.4.1'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jemoji'
end

gem 'kramdown'
gem 'kramdown-parser-gfm'

# Windows support: Windows has no system timezone database, Jekyll needs this to start
gem 'tzinfo-data'
